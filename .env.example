# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example local: mongodb://localhost:27017/urban_heat_analytics
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/urban_heat_analytics
MONGODB_URI=mongodb://localhost:27017/urban_heat_analytics

# Client URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173
